using System;
using System.Runtime.InteropServices;
using Core;
using Core.Net;
using UnityEngine;
using cCli = Core.Net.Cli;

namespace Wrap.Net
{
    /// <summary>
    /// 
    /// </summary>
    public struct Cli
    {
        internal Sock sock;
        internal SockAddr addr, roomaddr;
        internal globplayer_t _gplayer;

        public GlobPlayerIndex gplayer { get { 
		GlobPlayerIndex idx ;
		idx.a = _gplayer;
		return idx;
	} }

        public Cli([MarshalAs(UnmanagedType.LPStr)] string ip, ushort port)
        {
		Debug.Log("Starting [Wrap.Net.Cli]");
            addr = new SockAddr(ip, port);
            sock = new Sock();
            _gplayer = GlobPlayerIndex.INVALID;
        }

        public void ReqRoomJoin(
            room_t room,
            [MarshalAs(UnmanagedType.LPStr)] string pw,
            [MarshalAs(UnmanagedType.LPStr)] string clientname
        )
        {
            cCli.ReqRoomLobby(
                sock.fd, in addr, room,
                out _gplayer,
                null, pw, clientname
                );
        }

        public void ReqRoomExit()
        {
            room_t r = RoomIndex.INVALID;

            cCli.ReqRoomLobby(
                sock.fd, addr, r,
                out _gplayer, null, null, ""
            );
            return;
        }

        public void ReqRoomNewMatch(
            [MarshalAs(UnmanagedType.LPStr)] string clientname
            )
        {
            room_t r; r = RoomIndex.INVALID;

            cCli.ReqRoomLobby(
                sock.fd, in addr, r,
                out _gplayer, null, null, clientname
            );
            return;
        }

        public void ReqRoomNewCustom(
            [MarshalAs(UnmanagedType.LPStr)] string name,
            [MarshalAs(UnmanagedType.LPStr)] string pw,
            [MarshalAs(UnmanagedType.LPStr)] string clientname
        )
        {
            if (name == null)
                throw new Exception("[ReqRoomNewCustom] name cannot be null.");

            room_t inv; inv = RoomIndex.INVALID;

            cCli.ReqRoomLobby(
                this.sock.fd, addr, inv,
                out _gplayer, name, pw, clientname
            );
        }

        unsafe public Room[] ReqRoomShow(room_t startidx, room_t count)
        {
            Room[] arr = new Room[((int)count)];
            room_t ridx;
            ridx = 2;

            cCli.SetTimeOut(50);
            Debug.Log($"{startidx} {count} {cCli.SetTimeOut(0)}");

            fixed (Room* rr = arr)
            {
                cCli.ReqRoomShow(
                    this.sock.fd, this.addr
                    , startidx, count
                    , rr, out ridx
                    );
            }

            Debug.Log($"[ReqRoomShow] Successfully got {ridx} rooms.");

            if(ridx == 0) {
                return new Room[0];
            }

            if (ridx == RoomIndex.INVALID)
            {
                Debug.LogError("[ReqRoomShow] has failed.");
                return new Room[0];
            }
            else if(ridx < count)
            {
                Room[] a = new Room[ridx];

                room_t i; i = 0;

                for (; i < ridx; i++)
                {
                    a[i] = arr[i];
                }

                return a;
            }

            return arr;
        }
    }
}
